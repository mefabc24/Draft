<UserControl
    x:Class="Draft.Settings.Views.Pages.AppearanceSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i18n="clr-namespace:Draft.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:section="clr-namespace:Draft.Settings.Controls"
    xmlns:settings="clr-namespace:Draft.Settings.Controls"
    d:DesignHeight="2000"
    d:DesignWidth="540"
    mc:Ignorable="d">
    <Border Background="Transparent">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource SettingsScrollViewer}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Top">
                <section:SectionHeader Title="{i18n:Loc settings.appearance.themeSection}" />

                <settings:SettingCard
                    settings:SettingsSearch.TargetId="settings.appearance.appTheme"
                    Title="{i18n:Loc settings.appearance.appTheme}"
                    Margin="0,0,0,48"
                    Description="{i18n:Loc settings.appearance.appTheme.description}">
                    <StackPanel Width="220">
                        <ComboBox
                            Height="36"
                            HorizontalAlignment="Stretch"
                            ItemTemplate="{StaticResource LocalizedComboBoxItemTemplate}"
                            ItemsSource="{Binding AppThemeOptions}"
                            SelectedItem="{Binding Settings.AppTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource SettingsComboBox}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Font.Inter}"
                                FontSize="11"
                                Foreground="{StaticResource Brush.Text.Secondary}"
                                Text="{i18n:Loc settings.appearance.syncMarkdownTheme}"
                                TextWrapping="Wrap" />
                            <CheckBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding Settings.SyncMarkdownThemeWithAppTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource SettingsCheckBox}" />
                        </Grid>
                    </StackPanel>
                </settings:SettingCard>

                <section:SectionHeader Title="{i18n:Loc settings.appearance.layoutSection}" />

                <settings:SettingCard
                    settings:SettingsSearch.TargetId="settings.appearance.toolbarPosition"
                    Title="{i18n:Loc settings.appearance.toolbarPosition}"
                    Margin="0,0,0,48"
                    Description="{i18n:Loc settings.appearance.toolbarPosition.description}">
                    <ComboBox
                        Width="160"
                        Height="36"
                        IsEnabled="False"
                        ItemTemplate="{StaticResource LocalizedComboBoxItemTemplate}"
                        ItemsSource="{Binding ToolbarControlbarPositionOptions}"
                        SelectedItem="{Binding Settings.ToolbarControlbarPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource SettingsComboBox}" />
                </settings:SettingCard>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
